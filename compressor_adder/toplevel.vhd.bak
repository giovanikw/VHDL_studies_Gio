--libs
library ieee;
use ieee.std_logic_1164.all;

--define entity
entity toplevel is 
port(
		A, B, C: in std_logic;
		Carry, Sum: out std_logic
	);

end toplevel;

--define behaviour
	architecture behaviour of toplevel is
	--signal Bs, Cs in std_logic;

	begin

		compressor : mux.work
			port map(
				A => A;
				B => C;
				Sel => A xor B;
			);
		Sum <= Sel xor C;
end behaviour;